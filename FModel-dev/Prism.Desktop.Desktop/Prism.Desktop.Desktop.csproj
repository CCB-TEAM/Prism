<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Prism.Desktop\Assets\prism.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Desktop\Prism.Desktop.csproj" />
  </ItemGroup>

  <!-- 复制 UAssetCLI AOT 发布输出 -->
  <Target Name="CopyUAssetCli" AfterTargets="Publish">
    <ItemGroup>
      <_CliFiles Include="..\..\UAssetCLI\bin\Release\net10.0\win-x64\publish\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliFiles)"
          DestinationFiles="@(_CliFiles->'$(PublishDir)UAssetCLI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
