<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UAssetCLI\UAssetCLI.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\UAssetAPI-master\UAssetAPI\UAssetAPI.csproj" />
  </ItemGroup>

  <Target Name="CopyUAssetCliOutput" AfterTargets="Build">
    <ItemGroup>
      <UAssetCliOutput Include="..\UAssetCLI\bin\$(Configuration)\net10.0\*.*" />
        <UAssetCliOutput Include="..\UAssetCLI\bin\$(Configuration)\net10.0\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UAssetCliOutput)"
          DestinationFiles="@(UAssetCliOutput->'$(OutDir)UAssetCLI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
