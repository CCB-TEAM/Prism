<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Prism.Desktop\Assets\prism.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Desktop\Prism.Desktop.csproj" />
  </ItemGroup>

  <!--
    纹理替换与 Pak 转换依赖两样外部资源：
      1. UAssetCLI —— 桌面端做纹理重编码（astcenc / texconv）
      2. tools/    —— astcenc 与 texconv 本体
    二者都不在项目引用里，必须显式复制，否则应用能启动但相关功能全部不可用。

    历史坑：原先只在 Publish 后复制 UAssetCLI，于是照 README 执行 `dotnet build`
    得到的产物缺这两样 —— 开发时替换/转换直接不可用，且只在运行时才暴露。
    现在 Build 与 Publish 都复制。
  -->

  <!-- 优先用 AOT 发布产物（体积小、无需运行时）；没有则回退到普通 Release 构建 -->
  <PropertyGroup>
    <_CliPublishDir>$(MSBuildThisFileDirectory)..\UAssetCLI\bin\Release\net10.0\win-x64\publish\</_CliPublishDir>
    <_CliBuildDir>$(MSBuildThisFileDirectory)..\UAssetCLI\bin\Release\net10.0\win-x64\</_CliBuildDir>
  </PropertyGroup>

  <Target Name="CopyUAssetCliOutput" AfterTargets="Build">
    <ItemGroup>
      <_CliFromPublish Include="$(_CliPublishDir)UAssetCLI.*" />
      <_CliFromBuild Include="$(_CliBuildDir)UAssetCLI.*" />
    </ItemGroup>

    <ItemGroup Condition="'@(_CliFromPublish)' != ''">
      <_CliToCopy Include="@(_CliFromPublish)" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CliFromPublish)' == ''">
      <_CliToCopy Include="@(_CliFromBuild)" />
    </ItemGroup>

    <Copy SourceFiles="@(_CliToCopy)"
          DestinationFolder="$(OutDir)UAssetCLI\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />

    <Warning Condition="'@(_CliToCopy)' == ''"
             Text="未找到 UAssetCLI 产物（已尝试 AOT 发布与 Release 构建）。纹理替换与 Pak 转换将不可用。请先执行：dotnet build UAssetCLI -c Release" />
  </Target>

  <!-- 发布时复制 AOT 产物（与上面同源，保持发布包完整） -->
  <Target Name="CopyUAssetCliForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_CliPublishFiles Include="$(_CliPublishDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliPublishFiles)"
          DestinationFiles="@(_CliPublishFiles->'$(PublishDir)UAssetCLI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

  <!-- 编码器工具：从仓库里的 tools 目录复制 -->
  <Target Name="CopyEncoderTools" AfterTargets="Build">
    <ItemGroup>
      <_EncoderToolFiles Include="$(MSBuildThisFileDirectory)..\tools\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_EncoderToolFiles)"
          DestinationFolder="$(OutDir)tools\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

  <!--
    发布时也要带上编码器工具：Publish 不会重跑挂在 Build 上的目标，
    上一版就是因此导致发布包缺 tools/，实机表现为 ASTC/BC7 编码失败。
  -->
  <Target Name="CopyEncoderToolsForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_EncoderToolPublishFiles Include="$(MSBuildThisFileDirectory)..\tools\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_EncoderToolPublishFiles)"
          DestinationFolder="$(PublishDir)tools\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

  <!--
    Oodle 原生库（Windows）：与 Android 的 third_party/lib/arm64-v8a/liboodle-data-shared.so
    同一性质 —— 本地提供、不进仓库（third_party/lib 已在 .gitignore 中）。
    放在 third_party/lib/win-x64/oo2core_9_win64.dll 即可，构建与发布会自动带上。

    历史坑：这个文件以前只在开发目录里被手工拷过，**发布包从来没有**。于是设置里勾选
    「Oodle 压缩」后，repak_bind 按名字加载失败 → Rust panic → 直接 abort 整个进程
    （Windows 上 0xC0000409，.NET 拦不住，用户看到的就是"点一下闪退"）。
    Android 一直有这个库（走 AndroidNativeLibrary），Windows 侧从来没接上。
  -->
  <PropertyGroup>
    <_OodleWinDir>$(MSBuildThisFileDirectory)..\third_party\lib\win-x64\</_OodleWinDir>
  </PropertyGroup>

  <Target Name="CopyOodleNative" AfterTargets="Build">
    <ItemGroup>
      <_OodleWinFiles Include="$(_OodleWinDir)oo2core_*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OodleWinFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Message Condition="'@(_OodleWinFiles)' != ''"
             Importance="high"
             Text="已带上 Oodle 原生库：@(_OodleWinFiles->'%(Filename)%(Extension)')" />
  </Target>

  <!-- Publish 不会重跑挂在 Build 上的目标，必须单独再挂一次（与 tools/ 同理） -->
  <Target Name="CopyOodleNativeForPublish" AfterTargets="Publish">
    <ItemGroup>
      <_OodleWinPublishFiles Include="$(_OodleWinDir)oo2core_*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_OodleWinPublishFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
    <Warning Condition="'@(_OodleWinPublishFiles)' == ''"
             Text="未找到 Oodle 原生库（third_party/lib/win-x64/oo2core_9_win64.dll）。发布包将不带 Oodle，勾选「Oodle 压缩」时会自动降级为不压缩。" />
  </Target>

</Project>
