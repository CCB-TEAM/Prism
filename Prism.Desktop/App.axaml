<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prism.Desktop.App"
             xmlns:local="using:Prism.Desktop"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- 主题相关色（Light/Dark 两套） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PrimaryWashBrush" Color="#0d94881f" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#e4e3e0" />
                    <SolidColorBrush x:Key="CardBrush" Color="#f4f3f0" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#d6d5d1" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#67665f" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#33322e" />
                    <!-- 输入面：比卡片略亮，读起来是"可以打字的地方"，而不是和卡片同一块面 -->
                    <SolidColorBrush x:Key="FieldBrush" Color="#ffffff" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#cdccc7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryWashBrush" Color="#0d948833" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1b1b1d" />
                    <SolidColorBrush x:Key="CardBrush" Color="#262629" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#3a3a3d" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#b6b6ba" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ffffff" />
                    <!--
                        深色下 Fluent 默认把 TextBox 画成纯黑，压在 #262629 的卡片上像挖了个洞。
                        这里把它抬到比卡片高一档的灰，边界用更亮的描边，才像控件而不像缺口。
                    -->
                    <SolidColorBrush x:Key="FieldBrush" Color="#313135" />
                    <SolidColorBrush x:Key="FieldBorderBrush" Color="#4a4a4f" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 主题无关色 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#0d9488" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0b7f75" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#3cb8a8" />
            <SolidColorBrush x:Key="DangerBrush" Color="#b43a2a" />

            <!--
                字号资源（这里的值是「紧凑档」，即手机与窄窗用的那一套，与原设计一致）。
                宽屏时由 Services/LayoutDensity 把这些键改成放大一档的值 —— 视图里用
                {DynamicResource FsXX} 取值，于是只有文字变大，内边距与控件尺寸不变。

                为什么不做「整体缩放」：把整个界面按比例放大，内边距、控件、行高会一起变大，
                看起来像把手机界面拉大，而不是桌面版。只放大文字才对。
            -->
            <x:Double x:Key="Fs8">8</x:Double>
            <x:Double x:Key="Fs10">10</x:Double>
            <x:Double x:Key="Fs11">11</x:Double>
            <x:Double x:Key="Fs12">12</x:Double>
            <x:Double x:Key="Fs10_5">10.5</x:Double>
            <x:Double x:Key="Fs11_5">11.5</x:Double>
            <x:Double x:Key="Fs12_5">12.5</x:Double>
            <x:Double x:Key="Fs13_5">13.5</x:Double>
            <x:Double x:Key="Fs13">13</x:Double>
            <x:Double x:Key="Fs14">14</x:Double>
            <x:Double x:Key="Fs15">15</x:Double>
            <x:Double x:Key="Fs16">16</x:Double>
            <x:Double x:Key="Fs17">17</x:Double>
            <x:Double x:Key="Fs18">18</x:Double>
            <x:Double x:Key="Fs20">20</x:Double>
            <x:Double x:Key="Fs22">22</x:Double>
            <x:Double x:Key="Fs25">25</x:Double>
            <x:Double x:Key="Fs40">40</x:Double>

            <!-- 主题强调色（Fluent 控件拾取 SystemAccentColor） -->
            <Color x:Key="SystemAccentColor">#0d9488</Color>
            <Color x:Key="SystemAccentColorDark1">#0b7f75</Color>
            <Color x:Key="SystemAccentColorDark2">#096b63</Color>
            <Color x:Key="SystemAccentColorDark3">#075751</Color>
            <Color x:Key="SystemAccentColorLight1">#3cb8a8</Color>
            <Color x:Key="SystemAccentColorLight2">#6bcfc3</Color>
            <Color x:Key="SystemAccentColorLight3">#9ae0d8</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--
            ═══ 统一控件底座 ═══
            这些是"所有页面都必须长一样"的部分：圆角、输入面、默认按钮形态。
            原先圆角是散的（卡片 12、自定义按钮 8、Fluent 默认按钮与输入框各按自己的），
            输入框在深色下还是纯黑，压在卡片上像挖了个洞。
        -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 顶栏：返回按钮与页面标题。四个业务页原本各写一套，
             结果合并页成了灰色方块、标题字号 15/18/20 三种。 -->
        <Style Selector="Button.back">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource Fs16}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.back:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="{DynamicResource Fs18}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 次要动作（"浏览""选择""清空"）：用主色描出可点，而不是和正文同色的死文本 -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="{DynamicResource Fs11}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
        </Style>

        <!-- 标签页 -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12_5}" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 按钮：主按钮 -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        </Style>

        <!-- 按钮：强调（浅色底） -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 按钮：幽灵（无底） -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- 卡片 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 卡片按钮（主页功能入口） -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}" />
        </Style>

        <!--
            主页入口的图标底座。原先五个入口各是一个裸 emoji，粗细、色彩、视觉重量
            全随系统字体变化，摆在一起像五个不同年代的表情符号。套一个同尺寸的浅色
            方块之后，大小与位置立刻对齐，换成别的图标也不会散。
        -->
        <Style Selector="Border.icon-chip">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource PrimaryWashBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.icon-chip.small">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Application.Styles>
</Application>
