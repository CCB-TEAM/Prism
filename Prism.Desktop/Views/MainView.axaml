<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:views="using:Prism.Desktop.Views"
             x:Class="Prism.Desktop.Views.MainView"
             x:DataType="vm:MainViewModel">

    <!--
        应用外壳：左侧常驻导航（宽窗）+ 统一页头 + 底部状态栏 + 页面宿主。

        为什么要这层壳：原先五个页面各自画一条顶栏、各自放返回箭头，主入口是主页那张
        "五张大卡片"，其余页面都是它的二级页 —— 那是手机 App 的信息架构。窗口拉到
        1440 宽之后，它依然只有一个居中窄条和一条返回箭头，所以看着像"把手机界面
        拉大"，也就是"别扰"。现在宽窗改用桌面工具的常驻导航，页头与状态栏由外壳
        统一渲染，页面自己只管内容；窄窗与手机仍走"主页 → 二级页 → 返回"。

        页面切换的淡入由每个 ViewTransitionHost 负责，IsAnimationEnabled 绑定设置项，
        供低配设备或偏好静态界面的用户关闭。
    -->
    <Panel>
        <Panel>

            <!-- ═══ 侧边导航（宽窗）═══ -->
            <!--
                折叠用 IsVisible 直接显隐，不做宽度过渡。
                试过把 Width 从 216 过渡到 0：宽度是布局属性，过渡期间渲染宽度与布局列宽
                会对不上（侧栏画到一半、内容却按全宽排），页头和标签页直接压在侧栏上。
                布局类属性不该拿来做动画。
            -->
            <Border HorizontalAlignment="Left"
                    ZIndex="1"
                    Width="{Binding SidebarWidth}"
                    Classes="sidebar"
                    ClipToBounds="True"
                    IsVisible="{Binding CanCollapseSidebar}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,18,10,14">
                        <Button DockPanel.Dock="Right"
                                Content="«"
                                Classes="back"
                                VerticalAlignment="Top"
                                ToolTip.Tip="折叠导航"
                                Command="{Binding ToggleSidebarCommand}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Prism"
                                       FontSize="{DynamicResource Fs20}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Pak 资产管理工具"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding VersionText, StringFormat='v{0}'}"
                               FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="18,0,18,14" />

                    <StackPanel Margin="10,0" Spacing="2">
                        <Button Classes="nav"
                                Classes.active="{Binding IsHomeVisible}"
                                Command="{Binding GoHomeCommand}"
                                Content="欢迎" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsWorkspaceVisible}"
                                Command="{Binding GoWorkspaceCommand}"
                                Content="解包 &amp; 模组" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsMergeVisible}"
                                Command="{Binding GoMergeCommand}"
                                Content="Pak 合并" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsConvertVisible}"
                                Command="{Binding GoConvertCommand}"
                                Content="Pak 转换" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsDocsVisible}"
                                Command="{Binding OpenDocsCommand}"
                                CommandParameter="start"
                                Content="使用说明" />
                        <Button Classes="nav"
                                Classes.active="{Binding IsSettingsVisible}"
                                Command="{Binding GoSettingsCommand}"
                                Content="设置" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ 主区域 ═══ -->
            <DockPanel Margin="{Binding ContentMargin}">

                <!-- 页头：标题与使用说明由外壳统一渲染，页面里不再各写一条 -->
                <Border DockPanel.Dock="Top" Classes="page-header">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                            <!-- 窄窗/手机：返回主页（没有侧栏） -->
                            <Button Content="←"
                                    Classes="back"
                                    IsVisible="{Binding ShowBackButton}"
                                    Command="{Binding GoHomeCommand}" />
                            <!-- 桌面：侧栏被折叠后从这里展开 -->
                            <Button Content="☰"
                                    Classes="back"
                                    IsVisible="{Binding ShowSidebarToggle}"
                                    ToolTip.Tip="展开导航"
                                    Command="{Binding ToggleSidebarCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PageTitle}"
                                   Classes="page-title" />
                        <!--
                            工程标识：有工程时显示工程名，只有改动时显示「未保存的改动」。
                            它在这里而不是设置页，是因为"存下来"这件事必须在干活的当口顺手能点。
                        -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Spacing="6"
                                    IsVisible="{Binding ShowProjectChip}">
                            <TextBlock Text="●"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="有未保存的改动"
                                       IsVisible="{Binding IsProjectDirty}" />
                            <Button Content="{Binding ProjectChipText}"
                                    Classes="ghost"
                                    FontSize="{DynamicResource Fs11}"
                                    VerticalAlignment="Center"
                                    MaxWidth="220"
                                    ToolTip.Tip="{Binding ProjectChipTooltip}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="保存工程" InputGesture="Ctrl+S"
                                                  Command="{Binding SaveProjectCommand}" />
                                        <MenuItem Header="另存为…" Command="{Binding SaveProjectAsCommand}" />
                                        <Separator />
                                        <MenuItem Header="把素材收进工程"
                                                  ToggleType="CheckBox"
                                                  IsChecked="{Binding CollectProjectAssets}"
                                                  ToolTip.Tip="保存时把素材复制到旁边的 &lt;工程名&gt;.assets/，工程才能搬走或发给别人" />
                                        <Separator />
                                        <MenuItem Header="打开工程…" InputGesture="Ctrl+O"
                                                  Command="{Binding OpenProjectCommand}" />
                                        <MenuItem Header="关闭工程" Command="{Binding CloseProjectCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="使用说明"
                                Classes="ghost"
                                FontSize="{DynamicResource Fs11}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasPageHelp}"
                                Command="{Binding OpenDocsCommand}"
                                CommandParameter="{Binding PageHelpTopic}" />
                    </Grid>
                </Border>


                <!-- 状态栏：底部常驻，替换原先飘在页面中央的"就绪" -->
                <Border DockPanel.Dock="Bottom" Classes="statusbar">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentStatusText}"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding CurrentStatusText}" />
                        <ProgressBar Grid.Column="1"
                                     Width="90"
                                     Height="3"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 页面宿主 -->
                <Panel>
                    <views:ViewTransitionHost IsVisible="{Binding IsHomeVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="0"
                                              StartScale="0.985"
                                              Duration="0:0:0.28">
                        <views:HomeView x:Name="HomeViewControl" />
                    </views:ViewTransitionHost>

                    <views:ViewTransitionHost IsVisible="{Binding IsWorkspaceVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="12"
                                              Duration="0:0:0.24">
                        <views:WorkspaceView x:Name="WorkspaceViewControl" DataContext="{Binding}" />
                    </views:ViewTransitionHost>

                    <views:ViewTransitionHost IsVisible="{Binding IsMergeVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="16"
                                              Duration="0:0:0.24">
                        <views:MergeView x:Name="MergeViewControl" />
                    </views:ViewTransitionHost>

                    <views:ViewTransitionHost IsVisible="{Binding IsConvertVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="16"
                                              Duration="0:0:0.24">
                        <views:ConvertView x:Name="ConvertViewControl" />
                    </views:ViewTransitionHost>

                    <views:ViewTransitionHost IsVisible="{Binding IsSettingsVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="16"
                                              Duration="0:0:0.24">
                        <views:SettingsView x:Name="SettingsViewControl" />
                    </views:ViewTransitionHost>

                    <views:ViewTransitionHost IsVisible="{Binding IsDocsVisible}"
                                              IsAnimationEnabled="{Binding IsAnimationsEnabled}"
                                              OffsetY="16"
                                              Duration="0:0:0.24">
                        <views:HelpView x:Name="HelpViewControl" />
                    </views:ViewTransitionHost>
                </Panel>
            </DockPanel>
        </Panel>
    </Panel>
</UserControl>
