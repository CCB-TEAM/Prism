<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer>
        <StackPanel MaxWidth="620"
                    HorizontalAlignment="Stretch"
                    Margin="16,20"
                    Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="←"
                        FontSize="16"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Background="Transparent"
                        Command="{Binding GoHomeCommand}" />
                <TextBlock Text="设置"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 通用 -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="通用" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <CheckBox Content="显示纹理缩略图（默认开启，可在低配设备上关闭）"
                              IsChecked="{Binding ShowThumbnails}" />
                    <CheckBox Content="替换时使用 Oodle 压缩"
                              IsChecked="{Binding UseOodleCompression}" />
                    <CheckBox Content="合并前询问冲突替换"
                              IsChecked="{Binding AskBeforeReplace}" />
                </StackPanel>
            </Border>

            <!-- 路径 -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="路径" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Pak 文件" FontSize="11" Opacity="0.55" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding PakPath}"
                                     ToolTip.Tip="{Binding PakPath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowsePakCommand}"
                                    Classes="ghost" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Usmap 映射" FontSize="11" Opacity="0.55" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding UsmapPath}"
                                     ToolTip.Tip="{Binding UsmapPath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseUsmapCommand}"
                                    Classes="ghost" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="导出目录" FontSize="11" Opacity="0.55" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExportDirectory}"
                                     ToolTip.Tip="{Binding ExportDirectory}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseExportDirCommand}"
                                    Classes="ghost" />
                        </Grid>
                        <TextBlock Text="Android 使用系统目录授权保存，不会申请“所有文件”权限。"
                                   FontSize="10"
                                   Opacity="0.5"
                                   IsVisible="{Binding IsAndroid}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 缓存（仅 Android 显示说明，桌面直接使用原路径） -->
            <Border Classes="card" Padding="22" IsVisible="{Binding IsAndroid}">
                <StackPanel Spacing="8">
                    <TextBlock Text="缓存" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Text="通过系统文件选择器选择的 Pak / Usmap / 合并 Pak 会复制到应用私有缓存。保持不变时下次启动继续使用；更换为新文件后，旧缓存会立即删除，未引用的临时缓存也会在启动时自动清理。"
                               FontSize="10"
                               Opacity="0.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 合并 -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="合并" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="合并 Pak" FontSize="11" Opacity="0.55" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding MergePakPath}"
                                     ToolTip.Tip="{Binding MergePakPath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseMergePakCommand}"
                                    Classes="ghost" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="合并输出" FontSize="11" Opacity="0.55" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding MergeOutputPath}"
                                     ToolTip.Tip="{Binding MergeOutputPath}" />
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Command="{Binding BrowseMergeOutputCommand}"
                                    Classes="ghost" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AES -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="8">
                    <TextBlock Text="AES 密钥" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBox Text="{Binding AesKey}"
                             PlaceholderText="如需解密请填写" />
                    <TextBlock Text="注意：AES 密钥会明文保存在本地配置文件（Prism.Desktop.settings.json）中。"
                               FontSize="10"
                               Opacity="0.5"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 信息 -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="信息" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="版本" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VersionText}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Text="{Binding CliStatus}" FontSize="13" />
                    <TextBlock Text="{Binding AstcencStatus}" FontSize="13" />
                    <TextBlock Text="{Binding TexconvStatus}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="临时目录" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TempDirectory}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Classes="card" Padding="22">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <TextBlock Text="日志" FontSize="12" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="导出日志"
                                Command="{Binding ExportLogCommand}"
                                Classes="ghost" />
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="10"
                            MaxHeight="260">
                        <ScrollViewer>
                            <TextBlock Text="{Binding LogText}"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
