<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.HomeView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 功能入口统一尺寸，避免手机上过小点不到。
             取消固定宽高比，改由内容与 MinHeight 决定，便于放下 5 个入口。 -->
        <Style Selector="Button.home-entry">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.home-entry.wide">
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="MinHeight" Value="128" />
        </Style>
        <Style Selector="Button.home-entry.narrow">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <!--
            外层改成 Stretch、由内部元素自己定宽并居中：
            原先外层是 Center，宽度由内容撑开，于是下面那张 MaxWidth=1200 的网格
            实际只有内容想要的那点宽度 —— 五张卡片在 1440 宽的窗口里挤成 252px 一小块，
            两边各留 270px 死白。现在网格能真正用满 1200。
        -->
        <StackPanel HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="24,32"
                    Spacing="28">
            <StackPanel Spacing="6" IsVisible="{Binding ShowWelcomeBranding}">
                <TextBlock Text="Prism"
                           FontSize="{DynamicResource Fs40}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Text="Pak 资产管理工具"
                           FontSize="{DynamicResource Fs13}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!--
                宽屏：6 列网格。每张卡片跨 2 列，第 1 行 3 张、第 2 行 2 张居中，
                这样 5 个入口比"一行 3 个大卡"更紧凑，也不会挤在一起。
            -->
            
            <Grid x:Name="WideCards"
                  ColumnDefinitions="*,*,*,*,*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10"
                  MaxWidth="{Binding HomeGridMaxWidth}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding ShowWideCards}">

                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Command="{Binding GoWorkspaceCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="📦" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="解包 &amp; 模组"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="浏览 Pak 内容，导出资源，创建替换模组"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                        Command="{Binding GoMergeCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔗" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pak 合并"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="多选 Pak，拖动调整覆盖顺序后合成一个"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                        Command="{Binding GoConvertCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔄" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pak 转换"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="把另一个 Pak 的贴图按本平台格式重编码后并入"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <!-- 第 2 行：2 张卡片居中（各跨 2 列，整体占中间 4 列） -->
                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Command="{Binding GoBrowseCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔍" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="搜索 &amp; 导出"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="按关键词或路径定位资源，批量导出与分享"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                        Command="{Binding GoSettingsCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="⚙" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="设置"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="路径、映射、导出与工具选项"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 窄屏：入口纵向排列，保持等宽等高 -->
            <StackPanel x:Name="NarrowCards"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding ShowNarrowCards}">
                <Button Command="{Binding GoWorkspaceCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="解包 &amp; 模组" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="浏览 Pak 内容，导出资源，创建替换模组"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Command="{Binding GoMergeCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Pak 合并" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="多选 Pak 并拖动调整覆盖顺序"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Command="{Binding GoConvertCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Pak 转换" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="按本平台格式重编码贴图后并入主 Pak"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Command="{Binding GoBrowseCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="搜索 &amp; 导出" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="按关键词或路径定位资源，批量导出与分享"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Command="{Binding GoSettingsCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="路径、映射、导出与工具选项"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
            <!--
                桌面（≥980px）的欢迎页：只放文字。
                窄窗/手机的入口卡片在上面，两种宽度各用各的形态，不是同一份内容的两种排版。
            -->
            <StackPanel Spacing="22"
                        MaxWidth="780"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding CanCollapseSidebar}">
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs14}">
                    <Run Text="Prism 把 UE 的 " />
                    <Run Text=".pak" FontFamily="Consolas, Courier New" />
                    <Run Text=" 当成文件系统来用：打开、浏览、预览、导出，也可以直接在包里做贴图替换、多 Pak 合并、跨平台转换与本地化编辑。当前版本 " />
                    <Run Text="{Binding VersionText}" />
                    <Run Text="。" />
                </TextBlock>

                <StackPanel Spacing="10">
                    <TextBlock Text="四个工作区"
                               FontSize="{DynamicResource Fs12}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}">
                        <Run Text="解包 &amp; 模组" FontWeight="SemiBold" />
                        <Run Text="　浏览包内文件、预览贴图与模型、导出资源；把选中的资产加入替换列表后，可以换贴图、改本地化，再构建补丁 Pak。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}">
                        <Run Text="Pak 合并" FontWeight="SemiBold" />
                        <Run Text="　把多个 Pak 合成一个，列表里越靠上的优先级越高。给出原版 .locres 作基准时，同名本地化文件会逐条三路合并，而不是整份覆盖。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}">
                        <Run Text="Pak 转换" FontWeight="SemiBold" />
                        <Run Text="　把另一个平台 Pak 里的同路径贴图搬到本平台：解出源像素，按主 Pak 的纹理格式重新编码，再打成新 Pak。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}">
                        <Run Text="设置" FontWeight="SemiBold" />
                        <Run Text="　Pak 与映射文件路径、AES 密钥、导出目录、主题，以及日志与诊断报告。" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="开始之前"
                               FontSize="{DynamicResource Fs12}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="映射文件（.usmap / .jmap）" FontWeight="SemiBold" />
                        <Run Text="　只有读取蓝图属性与跨平台转换需要；在「设置」里选一次即可，两个平台导出的映射通用。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="AES 密钥" FontWeight="SemiBold" />
                        <Run Text="　只有加密 Pak 需要。密钥以明文保存在本机设置文件里，分享截图时注意避开。" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="编码器" FontWeight="SemiBold" />
                        <Run Text="　桌面端的贴图替换与转换依赖 UAssetCLI 与 astcenc / texconv，发行包已随附；Android 端在应用内完成编码。" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="从左侧「解包 &amp; 模组」开始。"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
