<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:services="using:Prism.Desktop.Services"
             xmlns:models="using:Prism.Desktop.Models"
             xmlns:local="using:Prism.Desktop.Views"
             x:Class="Prism.Desktop.Views.HomeView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 功能入口统一尺寸，避免手机上过小点不到。
             取消固定宽高比，改由内容与 MinHeight 决定，便于放下 5 个入口。 -->
        <Style Selector="Button.home-entry">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.home-entry.wide">
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="MinHeight" Value="128" />
        </Style>
        <Style Selector="Button.home-entry.narrow">
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="MinHeight" Value="62" />
        </Style>

        <!-- 更新说明的一行：小标题更重更亮，正文弱一档 -->
        <Style Selector="TextBlock.note-line">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.note-line.heading">
            <Setter Property="FontSize" Value="{DynamicResource Fs13}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <!--
            两个互斥的根：正常欢迎页 / 「有新版本」面板。
            前者由下面这段（原版欢迎页）渲染，后者把整页换成 GitHub 上的更新说明 ——
            用户的原话是"检测到新发行版就把欢迎界面改为更新内容"。
        -->
        <Panel>
        <!--
            外层改成 Stretch、由内部元素自己定宽并居中：
            原先外层是 Center，宽度由内容撑开，于是下面那张 MaxWidth=1200 的网格
            实际只有内容想要的那点宽度 —— 五张卡片在 1440 宽的窗口里挤成 252px 一小块，
            两边各留 270px 死白。现在网格能真正用满 1200。
        -->
        <StackPanel HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="24,32"
                    Spacing="28"
                    IsVisible="{Binding !ShowUpdatePanel}">
            <StackPanel Spacing="6" IsVisible="{Binding ShowWelcomeBranding}">
                <TextBlock Text="Prism"
                           FontSize="{DynamicResource Fs40}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <TextBlock Text="Pak 资产管理工具"
                           FontSize="{DynamicResource Fs13}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!--
                手机：一进来就是"接着上次的"（入口列表在下面，滚下去才看得到）。
                宽窗：这块挪到页面最下面（见文件末尾），上面先讲这里能做哪四件事。
            -->
            <local:RecentProjectsView IsVisible="{Binding IsCompact}" />

            <!--
                宽屏：6 列网格。每张卡片跨 2 列，第 1 行 3 张、第 2 行 2 张居中，
                这样 5 个入口比"一行 3 个大卡"更紧凑，也不会挤在一起。
            -->
            
            <Grid x:Name="WideCards"
                  ColumnDefinitions="*,*,*,*,*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10"
                  MaxWidth="{Binding HomeGridMaxWidth}"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding ShowWideCards}">

                <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Command="{Binding GoWorkspaceCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="📦" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="解包 &amp; 模组"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="浏览 Pak 内容，导出资源，创建替换模组"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                        Command="{Binding GoMergeCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔗" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pak 合并"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="多选 Pak，拖动调整覆盖顺序后合成一个"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2"
                        Command="{Binding GoConvertCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔄" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Pak 转换"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="把另一个 Pak 的贴图按本平台格式重编码后并入"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <!-- 第 2 行：2 张卡片居中（各跨 2 列，整体占中间 4 列） -->
                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Command="{Binding GoBrowseCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="🔍" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="搜索 &amp; 导出"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="按关键词或路径定位资源，批量导出与分享"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                        Command="{Binding GoSettingsCommand}"
                        Classes="card home-entry wide">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                        <Border Classes="icon-chip">
                            <TextBlock Text="⚙" FontSize="{DynamicResource Fs20}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="设置"
                                   FontSize="{DynamicResource Fs13_5}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="路径、映射、导出与工具选项"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 窄屏：入口纵向排列，保持等宽等高 -->
            <StackPanel x:Name="NarrowCards"
                        MaxWidth="420"
                        HorizontalAlignment="Stretch"
                        Spacing="10"
                        IsVisible="{Binding ShowNarrowCards}">
                <Button Command="{Binding GoWorkspaceCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="解包 &amp; 模组" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="浏览 Pak 内容，导出资源，创建替换模组"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>                </Button>
                <Button Command="{Binding GoMergeCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔗" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Pak 合并" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="多选 Pak 并拖动调整覆盖顺序"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>                </Button>
                <Button Command="{Binding GoConvertCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Pak 转换" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="按本平台格式重编码贴图后并入主 Pak"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>                </Button>
                <Button Command="{Binding GoBrowseCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="搜索 &amp; 导出" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="按关键词或路径定位资源，批量导出与分享"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>                </Button>
                <Button Command="{Binding GoSettingsCommand}" Classes="card home-entry narrow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="icon-chip small" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="{DynamicResource Fs16}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold" />
                            <TextBlock Text="路径、映射、导出与工具选项"
                                       FontSize="{DynamicResource Fs10_5}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>                </Button>
            </StackPanel>
            <!--
                桌面（≥980px）的欢迎页。
                不是"一段说明文字"，而是一页有层次的静态内容：引题区 → 分隔线 →
                两栏（左：四个工作区，逐条编号；右：开始之前要准备的东西）。
                侧栏已经提供导航，所以这里不再放任何按钮。
            -->
            <StackPanel MaxWidth="1060"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding CanCollapseSidebar}">

                <!-- ── 引题区：左侧一道主色细条 + 标签行 + 大标题 ── -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Grid.Column="0"
                            Width="3"
                            CornerRadius="2"
                            Background="{DynamicResource PrimaryBrush}"
                            Margin="0,5,0,5" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   LetterSpacing="1.4">
                            <Run Text="PRISM · PAK 资产管理工具 · v" />
                            <Run Text="{Binding VersionText}" />
                        </TextBlock>
                        <TextBlock Text="把 .pak 当成文件系统来用"
                                   FontSize="{DynamicResource Fs25}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock TextWrapping="Wrap"
                           MaxWidth="620"
                           HorizontalAlignment="Left"
                           Margin="0,14,0,0"
                           FontSize="{DynamicResource Fs13}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="打开、浏览、预览、导出，也能直接在包里做贴图替换、多 Pak 合并、跨平台转换与本地化编辑。全部在本机完成，不上传任何文件。" />

                <!-- ── 分隔线 ── -->
                <Border Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Margin="0,28,0,24" />

                <!-- ── 两栏：左 工作区 / 右 开始之前（中间一道竖线） ── -->
                <Grid ColumnDefinitions="*,Auto,*">

                    <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,0,0">
                        <TextBlock Text="四个工作区"
                                   FontSize="{DynamicResource Fs10}"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="01"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="解包 &amp; 模组" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="浏览包内文件、预览贴图与模型、导出资源；把资产加入替换列表后换贴图、改本地化，再构建补丁 Pak。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="02"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Pak 合并" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="多个 Pak 合成一个，越靠上的优先级越高。给出原版 .locres 作基准时，同名本地化文件逐条三路合并，而不是整份覆盖。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="03"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Pak 转换" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="把另一个平台 Pak 里同路径的贴图搬到本平台：解出源像素，按主 Pak 的纹理格式重编码，再打成新 Pak。" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="04"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="设置" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="Pak 与映射文件路径、AES 密钥、导出目录、主题，以及日志与诊断报告。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource DividerBrush}"
                            Margin="32,0" />

                    <StackPanel Grid.Column="2" Spacing="16">
                        <TextBlock Text="开始之前"
                                   FontSize="{DynamicResource Fs10}"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="映射文件" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text=".usmap / .jmap。只有读取蓝图属性与跨平台转换需要，在「设置」里选一次即可，两个平台导出的映射通用。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="AES 密钥" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="只有加密 Pak 需要。密钥以明文保存在本机设置文件里，分享截图时注意避开。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="编码器" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="桌面端的贴图替换与转换依赖 UAssetCLI 与 astcenc / texconv，发行包已随附；Android 端在应用内完成编码。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Oodle 压缩" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="默认关闭。开启需要本机具备 oo2core 原生库，缺失时会自动降级为不压缩并在状态栏说明。" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── 页脚提示 ── -->
                <Border Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Margin="0,28,0,18" />
                <TextBlock FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource PrimaryBrush}">
                    <Run Text="从左侧「解包 &amp; 模组」开始" />
                    <Run Text="　·　放入游戏的 Pak 请放在 Paks 目录下" Foreground="{DynamicResource TextMutedBrush}" />
                </TextBlock>

                <!--
                    最近工程（宽窗版）：放在页面最下面。
                    上面讲"这里能做哪四件事"（介绍），这里才是"接着上次的干什么"（入口）；
                    没有工程时整段不出现，新用户看到的就是原来那屏欢迎页。
                -->
                <local:RecentProjectsView />
            </StackPanel>

            <!--
                手机页脚：没有侧栏，上面那句"从左侧开始"在这儿是错的。
                这一句放在宽窗文档区外面，否则窄屏整块都是隐藏的（踩过）。
            -->
            <TextBlock FontSize="{DynamicResource Fs11}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="点上面任一入口开始 · 全部在本机完成，不上传任何文件"
                       IsVisible="{Binding IsCompact}" />

        </StackPanel>

        <!--
            ═══ 更新面板 ═══
            与欢迎页同一套排版语言：左侧主色细条 + 标签行 + 大标题 → 分隔线 →「更新内容」。
            发行说明是 markdown，已由 Services/UpdateNotes 解析成块，这里只负责画出来。
        -->
        <StackPanel IsVisible="{Binding ShowUpdatePanel}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    MaxWidth="880"
                    Margin="24,32,24,40"
                    Spacing="0">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0"
                        Width="3"
                        CornerRadius="2"
                        Background="{DynamicResource PrimaryBrush}"
                        Margin="0,5,0,5" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource PrimaryBrush}"
                               LetterSpacing="1.4">
                        <Run Text="新版本可用 · v" />
                        <Run Text="{Binding UpdateVersion}" />
                        <Run Text="　·　" Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="{Binding UpdatePublishedText}" Foreground="{DynamicResource TextMutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding UpdateTitle}"
                               FontSize="{DynamicResource Fs25}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding UpdateIntroText}"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       Margin="0,14,0,0"
                       FontSize="{DynamicResource Fs13}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />

            <Border Height="1"
                    Background="{DynamicResource DividerBrush}"
                    Margin="0,26,0,20" />

            <TextBlock Text="更新内容"
                       FontSize="{DynamicResource Fs10}"
                       LetterSpacing="1.2"
                       Foreground="{DynamicResource TextMutedBrush}" />

            <ItemsControl ItemsSource="{Binding UpdateNoteBlocks}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:UpdateNote">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <TextBlock Grid.Column="0"
                                       Text="·"
                                       FontSize="{DynamicResource Fs14}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,-2,0,0"
                                       IsVisible="{Binding IsBullet}" />
                            <TextBlock Grid.Column="1"
                                       Classes="note-line"
                                       Classes.heading="{Binding IsHeading}"
                                       TextWrapping="Wrap"
                                       local:RichText.Runs="{Binding Runs}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1"
                    Background="{DynamicResource DividerBrush}"
                    Margin="0,24,0,18" />

            <!-- 安装包与动作 -->
            <TextBlock Text="{Binding UpdatePackageText}"
                       FontSize="{DynamicResource Fs11}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{Binding InstallButtonText}"
                        Classes="primary"
                        Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding CanInstallUpdate}" />
                <Button Content="在 GitHub 上查看"
                        Classes="accent"
                        Command="{Binding OpenReleasePageCommand}" />
                <Button Content="稍后再说"
                        Classes="ghost"
                        Command="{Binding DismissUpdateCommand}" />
            </StackPanel>

            <ProgressBar Height="3"
                         Minimum="0" Maximum="1"
                         Margin="0,14,0,0"
                         Value="{Binding UpdateProgress}"
                         IsVisible="{Binding IsUpdateDownloading}" />

            <TextBlock Text="{Binding UpdateActionStatus}"
                       FontSize="{DynamicResource Fs11}"
                       Foreground="{DynamicResource PrimaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       IsVisible="{Binding UpdateActionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
