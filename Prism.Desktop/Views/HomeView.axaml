<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.HomeView"
             x:DataType="vm:MainViewModel">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="52">
        <StackPanel Spacing="8">
            <TextBlock Text="Prism"
                       FontSize="52"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Pak 资产管理工具"
                       FontSize="14"
                       Opacity="0.6"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="24"
              MaxWidth="520"
              HorizontalAlignment="Center">
            <Button Command="{Binding GoWorkspaceCommand}"
                    Classes="card"
                    Padding="28,32"
                    HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="📦"
                               FontSize="34"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="解包 &amp; 模组"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="浏览 Pak 内容，导出资源，创建替换模组"
                               FontSize="11"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               MaxWidth="190"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Command="{Binding GoMergeCommand}"
                    Classes="card"
                    Padding="28,32"
                    HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="🔗"
                               FontSize="34"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pak 合并"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="合并多个 Pak 文件，管理依赖与冲突"
                               FontSize="11"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               MaxWidth="190"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   Opacity="0.6"
                   HorizontalAlignment="Center" />

        <!-- 设置入口 -->
        <Button Content="⚙ 设置"
                Command="{Binding GoSettingsCommand}"
                Classes="ghost"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
