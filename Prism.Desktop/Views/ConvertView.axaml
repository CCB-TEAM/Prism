<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.ConvertView"
             x:DataType="vm:MainViewModel">

    <!-- 用 Panel 叠一层页内浮层：说明放在这里，正文只留最短的标签。
         不用独立 Window 是因为 Android 上 TopLevel 不一定是 Window，
         ShowDialog 拿不到宿主；浮层两端行为一致。 -->
    <Panel>
        <DockPanel>
            <!-- 顶栏 -->
            <Border DockPanel.Dock="Top" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="←"
                            FontSize="{DynamicResource Fs16}"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Background="Transparent"
                            Command="{Binding GoHomeCommand}"
                            Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Text="Pak 转换"
                               FontSize="{DynamicResource Fs15}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Content="使用说明"
                            Command="{Binding OpenHelpCommand}" CommandParameter="convert"
                            Classes="ghost"
                            FontSize="{DynamicResource Fs11}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding ConvertStatus}"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{Binding TopStatusMaxWidth}"
                               ToolTip.Tip="{Binding ConvertStatus}" />
                </Grid>
            </Border>

            <ProgressBar DockPanel.Dock="Top"
                         Height="3"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}" />

            <ScrollViewer>
                <StackPanel MaxWidth="{Binding ConvertContentMaxWidth}"
                            HorizontalAlignment="Stretch"
                            Margin="16,18"
                            Spacing="14">

                    <!-- ═══ 输入 ═══ -->
                    <Border Classes="card" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="主 Pak" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PakPath}" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding PakPath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowsePakCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="待转换 Pak" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ConvertSourcePath}" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ConvertSourcePath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowseConvertSourceCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="输出" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ConvertOutputPath}" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ConvertOutputPath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowseConvertOutputCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <TextBlock Text="未选择主 Pak，请先选择后再回到本页。"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       IsVisible="{Binding IsPakPathEmpty}" />

                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <CheckBox Content="并入模组的其他文件（蓝图 / 本地化等）"
                                          IsChecked="{Binding ConvertIncludeModFiles}" />
                                <CheckBox Content="输出完整整包"
                                          IsChecked="{Binding ConvertMergeAll}" />
                            </StackPanel>

                            <!-- 密钥/映射是这次"转换出废包"的直接原因，所以状态要摆在页面上。
                                 加密 Pak 没有密钥时挂载会成功但读到 0 个文件，服务端会拦下并报错。 -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding AesKeySummary}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding MappingSummary}" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding UsmapPath}" />
                            </StackPanel>

                            <!-- 可操作的前置条件才留在页面上，其余解释都进「使用说明」。 -->
                            <TextBlock Text="⚠ 缺映射文件，跨格式贴图会被跳过"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding NeedsMappingsForConversion}" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ 执行 ═══ -->
                    <Border Classes="card" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Button Grid.Column="0"
                                        Content="开始转换"
                                        Command="{Binding ConvertPakCommand}"
                                        Classes="primary"
                                        MinWidth="110" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConvertStatus}"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="{Binding ConvertServiceStatus}"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />

                            <!-- 结果明细 -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasConvertRows}">
                                <DockPanel>
                                    <TextBlock Text="转换明细" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            Content="清空"
                                            Command="{Binding ClearConvertRowsCommand}"
                                            Classes="ghost"
                                            FontSize="{DynamicResource Fs10}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding ConvertRows}"
                                         MaxHeight="260"
                                         Background="{DynamicResource SurfaceBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PakConversionRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,1">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource PrimaryWashBrush}"
                                                        CornerRadius="5"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PakPath}"
                                                           FontSize="{DynamicResource Fs11}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding PakPath}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Message}"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasMessage}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Message}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
