<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.ConvertView"
             x:DataType="vm:MainViewModel">

    <!-- 用 Panel 叠一层页内浮层：说明放在这里，正文只留最短的标签。
         不用独立 Window 是因为 Android 上 TopLevel 不一定是 Window，
         ShowDialog 拿不到宿主；浮层两端行为一致。 -->
    <Panel>
        <DockPanel>
            <!-- 顶栏 -->
            <Border DockPanel.Dock="Top" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="←"
                            FontSize="16"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Background="Transparent"
                            Command="{Binding GoHomeCommand}"
                            Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Text="Pak 转换"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Content="使用说明"
                            Command="{Binding ShowConvertHelpCommand}"
                            Classes="ghost"
                            FontSize="11"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding ConvertStatus}"
                               FontSize="11"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{Binding TopStatusMaxWidth}"
                               ToolTip.Tip="{Binding ConvertStatus}" />
                </Grid>
            </Border>

            <ProgressBar DockPanel.Dock="Top"
                         Height="3"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}" />

            <ScrollViewer>
                <StackPanel MaxWidth="620"
                            HorizontalAlignment="Stretch"
                            Margin="16,18"
                            Spacing="14">

                    <!-- ═══ 输入 ═══ -->
                    <Border Classes="card" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="主 Pak" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PakPath}" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding PakPath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowsePakCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="待转换 Pak" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ConvertSourcePath}" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ConvertSourcePath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowseConvertSourceCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="输出" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ConvertOutputPath}" FontSize="12" Opacity="0.85"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ConvertOutputPath}" />
                                <Button Grid.Column="2" Content="选择" Command="{Binding BrowseConvertOutputCommand}"
                                        Classes="ghost" />
                            </Grid>

                            <TextBlock Text="未选择主 Pak，请先选择后再回到本页。"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerBrush}"
                                       IsVisible="{Binding IsPakPathEmpty}" />

                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <CheckBox Content="并入模组的其他文件（蓝图 / 本地化等）"
                                          IsChecked="{Binding ConvertIncludeModFiles}" />
                                <CheckBox Content="输出完整整包"
                                          IsChecked="{Binding ConvertMergeAll}" />
                            </StackPanel>

                            <!-- 可操作的前置条件才留在页面上，其余解释都进「使用说明」。 -->
                            <TextBlock Text="⚠ 缺映射文件，跨格式贴图会被跳过"
                                       FontSize="10"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding NeedsMappingsForConversion}" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ 执行 ═══ -->
                    <Border Classes="card" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Button Grid.Column="0"
                                        Content="开始转换"
                                        Command="{Binding ConvertPakCommand}"
                                        Classes="primary"
                                        MinWidth="110" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConvertStatus}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="{Binding ConvertServiceStatus}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />

                            <!-- 结果明细 -->
                            <StackPanel Spacing="6" IsVisible="{Binding HasConvertRows}">
                                <DockPanel>
                                    <TextBlock Text="转换明细" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            Content="清空"
                                            Command="{Binding ClearConvertRowsCommand}"
                                            Classes="ghost"
                                            FontSize="10" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding ConvertRows}"
                                         MaxHeight="260"
                                         Background="{DynamicResource SurfaceBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PakConversionRow">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,1">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource PrimaryWashBrush}"
                                                        CornerRadius="5"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                               Foreground="{DynamicResource PrimaryBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PakPath}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding PakPath}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Message}"
                                                           FontSize="10"
                                                           Opacity="0.55"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasMessage}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Message}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══ 使用说明浮层 ═══ -->
        <Border IsVisible="{Binding IsConvertHelpVisible}"
                Background="#A0000000">
            <Border Classes="card"
                    MaxWidth="580"
                    MaxHeight="640"
                    Margin="24"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,14,10">
                        <TextBlock Grid.Column="0" Text="Pak 转换 · 使用说明"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseConvertHelpCommand}"
                                Classes="ghost" FontSize="12" Padding="8,2" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom"
                            Content="知道了"
                            Command="{Binding CloseConvertHelpCommand}"
                            Classes="primary"
                            HorizontalAlignment="Right"
                            Margin="20,10,20,18"
                            MinWidth="90" />

                    <ScrollViewer Margin="20,0,20,0">
                        <StackPanel Spacing="14">

                            <StackPanel Spacing="6">
                                <TextBlock Text="用途" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="把另一个平台 Pak 里的同路径贴图搬到本平台：解出源贴图像素 → 按主 Pak 的纹理格式重新编码 → 合成新 Pak。" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="三步" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                <!-- 浮层会盖住页面，所以这里放一张页面截图当参照 -->
                                <Border CornerRadius="8" ClipToBounds="True" Margin="0,2,0,4"
                                        BorderBrush="#22000000" BorderThickness="1">
                                    <Image Source="avares://Prism.Desktop/Assets/help/convert-page.png"
                                           Stretch="Uniform" />
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="1. 主 Pak：选本平台要装进游戏的那个 Pak（它决定输出的纹理格式）。" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="2. 待转换 Pak：选另一个平台的 Pak，它提供新贴图。" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="3. 输出：选保存位置，点「开始转换」。完成后把输出 Pak 放进游戏的 Paks 目录。" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="输出里装什么" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• 默认：只装转换过的贴图，体积≈改动量。游戏会把它叠加在原 Pak 之上，同路径以后加载的为准。" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• 并入模组的其他文件：再带上源 Pak 的蓝图、本地化、数据表等。这些内容双端通用，不需要转换，会原样复制进输出 Pak —— 开了它就不必再单独做一次 Pak 合并。" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• 输出完整整包：连主 Pak 的其他文件一起打包，体积≈主 Pak。只在需要「用一个 Pak 替换整包」时用。" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="开始前检查" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• 映射文件：两侧贴图格式不同时必须解出源像素才能重编码，这一步需要 .usmap / .jmap（在「设置」页选择，两个平台导出的映射通用）。缺映射的贴图会被跳过并在明细里写明原因。" />
                                <Border CornerRadius="8" ClipToBounds="True" Margin="0,2,0,4"
                                        BorderBrush="#22000000" BorderThickness="1"
                                        HorizontalAlignment="Left">
                                    <Image Source="avares://Prism.Desktop/Assets/help/settings-path.png"
                                           Stretch="Uniform" MaxWidth="480" />
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• AES 密钥：只有加密 Pak 需要，沿用「解包 &amp; 模组」页里填的。" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="• 编码器：桌面端需要 UAssetCLI 与 astcenc / texconv，发行版已随包提供（须与主程序放在一起）；Android 端在应用内完成编码。" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="结果怎么看" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                           Text="转换完成后下方逐条列出每张贴图的处理结果：替换 / 主 Pak 缺失 / 跳过 / 失败。失败项会写明具体原因，可据此调整映射文件或输入 Pak。" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
