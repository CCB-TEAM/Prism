<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             xmlns:views="using:Prism.Desktop.Views"
             x:Class="Prism.Desktop.Views.WorkspaceView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <!--
            顶栏（标题 / 返回 / 使用说明 / 状态）已上移到应用外壳 Views/MainView.axaml，
            五个页面共用一份。这里只留页面自己的内容。
        -->

        <!-- 忙时进度条 -->
        <ProgressBar DockPanel.Dock="Top"
                     Height="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />

        <!-- 标签行：宽屏标签在左、搜索固定右侧；窄屏搜索换到第二行，按钮不会再被挤出 -->
        <Border DockPanel.Dock="Top"
                Padding="12,4"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <DockPanel IsVisible="{Binding IsCompact, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="配置"
                                Classes="tab"
                                Classes.active="{Binding IsConfigTab}"
                                Command="{Binding SwitchConfigTabCommand}" />
                        <Button Content="浏览"
                                Classes="tab"
                                Classes.active="{Binding IsBrowseTab}"
                                Command="{Binding SwitchBrowseTabCommand}" />
                        <Button Content="替换"
                                Classes="tab"
                                Classes.active="{Binding IsPatchTab}"
                                Command="{Binding SwitchPatchTabCommand}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding IsBrowseTab}">
                        <TextBox Text="{Binding SearchQuery}"
                                 Width="{Binding SearchBoxWidth}"
                                 PlaceholderText="{Binding SearchPlaceholder}"
                                 FontSize="{DynamicResource Fs12}"
                                 KeyDown="OnSearchKeyDown" />
                        <Button Content="搜索"
                                Command="{Binding SearchCommand}"
                                Classes="ghost" />
                    </StackPanel>
                </DockPanel>

                <StackPanel IsVisible="{Binding IsCompact}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="配置"
                                Classes="tab"
                                Classes.active="{Binding IsConfigTab}"
                                Command="{Binding SwitchConfigTabCommand}" />
                        <Button Content="浏览"
                                Classes="tab"
                                Classes.active="{Binding IsBrowseTab}"
                                Command="{Binding SwitchBrowseTabCommand}" />
                        <Button Content="替换"
                                Classes="tab"
                                Classes.active="{Binding IsPatchTab}"
                                Command="{Binding SwitchPatchTabCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          Margin="0,2,0,0"
                          IsVisible="{Binding IsBrowseTab}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery}"
                                 PlaceholderText="{Binding SearchPlaceholder}"
                                 FontSize="{DynamicResource Fs12}"
                                 KeyDown="OnSearchKeyDown" />
                        <Button Grid.Column="1"
                                Content="搜索"
                                Command="{Binding SearchCommand}"
                                Classes="ghost" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 内容 -->
        <Panel>

            <!-- ═══════ 配置 ═══════ -->
            <ScrollViewer IsVisible="{Binding IsConfigTab}">
                <StackPanel Margin="16,20" Spacing="16" MaxWidth="{Binding WorkspaceConfigMaxWidth}" HorizontalAlignment="Stretch">
                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Pak 文件" Classes="card-title" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <!-- 只读路径也用输入框呈现：与设置页同一形态，空值时还有占位提示 -->
                                    <TextBox Grid.Column="0"
                                             Text="{Binding PakPath}"
                                             IsReadOnly="True"
                                             PlaceholderText="未选择"
                                             ToolTip.Tip="{Binding PakPath}" />
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding BrowsePakCommand}"
                                            Classes="link" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="映射文件（.usmap / .jmap）" Classes="card-title" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding UsmapPath}"
                                             IsReadOnly="True"
                                             PlaceholderText="未选择（可选）"
                                             ToolTip.Tip="{Binding UsmapPath}" />
                                    <Button Grid.Column="1"
                                            Content="选择"
                                            Command="{Binding BrowseUsmapCommand}"
                                            Classes="link" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="AES 密钥" Classes="card-title" />
                                <TextBox Text="{Binding AesKey}"
                                         PlaceholderText="如需解密请填写" />
                            </StackPanel>
                            <Button Content="打开 Pak"
                                    Command="{Binding OpenPakCommand}"
                                    Classes="primary"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="导出" Classes="card-title" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ExportDirectory}"
                                         PlaceholderText="导出目录"
                                         ToolTip.Tip="{Binding ExportDirectory}" />
                                <Button Grid.Column="1"
                                        Content="选择"
                                        Command="{Binding BrowseExportDirCommand}"
                                        Classes="link" />
                            </Grid>
                            <TextBlock Text="Android 会通过系统目录授权保存此位置，无需“所有文件”权限。"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding IsAndroid}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════ 浏览（响应式） ═══════ -->
            <Panel IsVisible="{Binding IsBrowseTab}">
                    <!-- 横屏：左列表 + 右详情 -->
                    <Grid x:Name="LandscapeLayout"
                          ColumnDefinitions="2*,3*">
                        <views:FileBrowserView />
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1,0,0,0"
                                Background="{DynamicResource CardBrush}">
                            <ScrollViewer>
                                <views:PreviewPaneView />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- 竖屏：列表 + 底部预览抽屉 -->
                    <DockPanel x:Name="PortraitLayout">
                        <Border x:Name="PortraitDrawer"
                                DockPanel.Dock="Bottom"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{DynamicResource CardBrush}"
                                BoxShadow="0 -4 20 0 #26000000">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="MaxHeight"
                                                      Duration="0:0:0.35"
                                                      Easing="CubicEaseOut" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel>
                                <!-- 把手（拖拽热区） -->
                                <Border x:Name="DrawerHandle"
                                        Height="22"
                                        Background="Transparent"
                                        Cursor="SizeNorthSouth"
                                        PointerPressed="OnDrawerHandlePressed"
                                        PointerMoved="OnDrawerHandleMoved"
                                        PointerReleased="OnDrawerHandleReleased">
                                    <Border Width="32"
                                            Height="4"
                                            CornerRadius="2"
                                            Background="{DynamicResource DividerBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Border>

                                <!-- 预览栏自带头部与滚动（见 PreviewPaneView），这里不再包一层 -->
                                <views:PreviewPaneView IsVisible="{Binding IsPreviewExpanded}" />
                            </StackPanel>
                        </Border>
                        <!-- 最后一个子元素填充剩余空间 -->
                        <views:FileBrowserView />
                    </DockPanel>
                </Panel>

            <!-- ═══════ 替换（响应式） ═══════ -->
            <Panel IsVisible="{Binding IsPatchTab}">
                    <!-- 横屏：左列表 + 右详情（双卡片并排） -->
                    <DockPanel x:Name="PatchLandscapeLayout">
                        <Border DockPanel.Dock="Top"
                                Padding="14,10"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="替换任务"
                                           FontSize="{DynamicResource Fs14}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PatchItems.Count, StringFormat=  （{0} 项）}"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                                    <CheckBox Content="Oodle 压缩"
                                              IsChecked="{Binding UseOodleCompression}"
                                              VerticalAlignment="Center" />
                                    <Button Content="构建 Pak"
                                            Command="{Binding BuildPatchPakCommand}"
                                            Classes="primary" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid ColumnDefinitions="300,*">
                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,1,0">
                                <ListBox ItemsSource="{Binding PatchItems}"
                                         SelectedItem="{Binding SelectedPatchItem}"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PatchItem">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="{DynamicResource Fs12}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Format}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourcePath}"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="已替换"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           IsVisible="{Binding IsReplaced}" />
                                                <TextBlock Text="失败"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           IsVisible="{Binding IsFailed}" />
                                                <TextBlock Text="待替换"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding IsPending}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <ScrollViewer Grid.Column="1">
                                <StackPanel Margin="18" Spacing="12">
                                    <TextBlock Text="从浏览页选好资产 →「加入替换」，再回到这里处理。"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding HasNoPatchItems}" />
                                    <StackPanel IsVisible="{Binding HasPatchItems}">
                                        <TextBlock Text="{Binding SelectedPatchItem.SourcePath}"
                                                   FontSize="{DynamicResource Fs12}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPatchItem.SourcePath}"/>

                                        <!-- locres 编辑器 -->
                                        <StackPanel IsVisible="{Binding SelectedPatchItem.IsLocres}">
                                            <TextBox Text="{Binding SelectedPatchItem.LocresFilterText}"
                                                     PlaceholderText="搜索本地化条目..."
                                                     FontSize="{DynamicResource Fs12}" />
                                            <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                IsVisible="{Binding SelectedPatchItem.IsPaged}">
                                                <Button Content="上一页"
                                                        Command="{Binding SelectedPatchItem.PrevLocresPageCommand}"
                                                        Classes="ghost"
                                                        FontSize="{DynamicResource Fs11}" />
                                                <TextBlock Text="{Binding SelectedPatchItem.LocresPageText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Button Content="下一页"
                                                        Command="{Binding SelectedPatchItem.NextLocresPageCommand}"
                                                        Classes="ghost"
                                                        FontSize="{DynamicResource Fs11}" />
                                            </StackPanel>
                                            <Button Content="导出 JSON"
                                                    Command="{Binding $parent[UserControl].DataContext.ExportPatchLocresJsonCommand}"
                                                    CommandParameter="{Binding SelectedPatchItem}"
                                                    Classes="ghost"
                                                    FontSize="{DynamicResource Fs11}"
                                                    HorizontalAlignment="Left" />
                                            <TextBlock Text="改完按回车写回，再构建补丁 Pak。"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <ListBox ItemsSource="{Binding SelectedPatchItem.FilteredLocresEntries}"
                                                     MaxHeight="420"
                                                     Background="Transparent">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="IsTabStop" Value="False" />
                                                    </Style>
                                                </ListBox.Styles>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LocresEntryVM">
                                                        <Grid ColumnDefinitions="180,*"
                                                              ColumnSpacing="8"
                                                              Margin="0,2">
                                                            <TextBlock Text="{Binding DisplayKey}"
                                                                       FontSize="{DynamicResource Fs11}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Text}"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="44"
                                                                     FontSize="{DynamicResource Fs12}"
                                                                     KeyDown="OnLocresTextKeyDown"
                                                                     LostFocus="OnLocresTextLostFocus" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <!-- 纹理对比卡片 -->
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="12"
                                              IsVisible="{Binding SelectedPatchItem.IsTexture}">
                                            <Border Classes="card" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="原始" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <Image Source="{Binding SelectedPatchItem.OriginalPreview}"
                                                           Stretch="Uniform"
                                                           MaxHeight="280" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Classes="card" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="替换" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <Image Source="{Binding SelectedPatchItem.ReplacementPreview}"
                                                           Stretch="Uniform"
                                                           MaxHeight="280" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.ReplacementText}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding SelectedPatchItem.Error}"
                                                   FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"
                                                   IsVisible="{Binding SelectedPatchItem.IsFailed}" />

                                        <!-- 音频 / 媒体文件 -->
                                        <Border Classes="card"
                                                Padding="14"
                                                IsVisible="{Binding SelectedPatchItem.IsMediaLike}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="原始" Classes="card-title" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.Detail}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="6"
                                                            IsVisible="{Binding SelectedPatchItem.IsAudio}">
                                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                    <TextBlock Text="编码质量" Classes="card-title" />
                                                    <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AudioQualities}"
                                                              SelectedItem="{Binding SelectedPatchItem.AudioQuality}"
                                                              HorizontalAlignment="Left"
                                                              MinWidth="180" />
                                                    <TextBlock Text="0 最好也最占空间，9 最省。编码后超过 256 KB 会自动切成多个流式块（和游戏自己切块的方式一致）。"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                    <TextBlock Text="替换" Classes="card-title" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.ReplacementText}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.ReplacementDetail}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding SelectedPatchItem.PickActionText}"
                                                    Command="{Binding PickReplacementCommand}"
                                                    Classes="accent"
                                                    IsVisible="{Binding SelectedPatchItem.CanPickFile}" />
                                            <Button Content="移除"
                                                    Command="{Binding RemovePatchItemCommand}"
                                                    Classes="ghost" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>

                    <!-- 竖屏：列表在上（180px）+ 详情在下（卡片单列） -->
                    <DockPanel x:Name="PatchPortraitLayout">
                        <Border DockPanel.Dock="Top"
                                Padding="12,8"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBlock Text="替换任务"
                                           FontSize="{DynamicResource Fs13}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PatchItems.Count, StringFormat=  （{0} 项）}"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right"
                                        Content="构建 Pak"
                                        Command="{Binding BuildPatchPakCommand}"
                                        Classes="primary"
                                        FontSize="{DynamicResource Fs11}"
                                        Padding="10,5" />
                            </DockPanel>
                        </Border>
                        <Grid RowDefinitions="180,*">
                            <ListBox Grid.Row="0"
                                     ItemsSource="{Binding PatchItems}"
                                     SelectedItem="{Binding SelectedPatchItem}"
                                     Background="Transparent"
                                     BorderBrush="{DynamicResource DividerBrush}"
                                     BorderThickness="0,0,0,1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PatchItem">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{DynamicResource Fs12}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Format}"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourcePath}"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="已替换"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       IsVisible="{Binding IsReplaced}" />
                                            <TextBlock Text="失败"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       IsVisible="{Binding IsFailed}" />
                                            <TextBlock Text="待替换"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       IsVisible="{Binding IsPending}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ScrollViewer Grid.Row="1">
                                <StackPanel Margin="14" Spacing="10">
                                    <TextBlock Text="从浏览页选好资产 →「加入替换」，再回到这里处理。"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding HasNoPatchItems}" />
                                    <StackPanel IsVisible="{Binding HasPatchItems}">
                                        <TextBlock Text="{Binding SelectedPatchItem.SourcePath}"
                                                   FontSize="{DynamicResource Fs12}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPatchItem.SourcePath}"/>

                                        <!-- locres 编辑器 -->
                                        <StackPanel IsVisible="{Binding SelectedPatchItem.IsLocres}">
                                            <TextBox Text="{Binding SelectedPatchItem.LocresFilterText}"
                                                     PlaceholderText="搜索本地化条目..."
                                                     FontSize="{DynamicResource Fs12}" />
                                            <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                IsVisible="{Binding SelectedPatchItem.IsPaged}">
                                                <Button Content="上一页"
                                                        Command="{Binding SelectedPatchItem.PrevLocresPageCommand}"
                                                        Classes="ghost"
                                                        FontSize="{DynamicResource Fs11}" />
                                                <TextBlock Text="{Binding SelectedPatchItem.LocresPageText}"
                                                           VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <Button Content="下一页"
                                                        Command="{Binding SelectedPatchItem.NextLocresPageCommand}"
                                                        Classes="ghost"
                                                        FontSize="{DynamicResource Fs11}" />
                                            </StackPanel>
                                            <Button Content="导出 JSON"
                                                    Command="{Binding $parent[UserControl].DataContext.ExportPatchLocresJsonCommand}"
                                                    CommandParameter="{Binding SelectedPatchItem}"
                                                    Classes="ghost"
                                                    FontSize="{DynamicResource Fs11}"
                                                    HorizontalAlignment="Left" />
                                            <TextBlock Text="改完按回车写回，再构建补丁 Pak。"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <ListBox ItemsSource="{Binding SelectedPatchItem.FilteredLocresEntries}"
                                                     MaxHeight="420"
                                                     Background="Transparent">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="IsTabStop" Value="False" />
                                                    </Style>
                                                </ListBox.Styles>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:LocresEntryVM">
                                                        <Grid ColumnDefinitions="120,*"
                                                              ColumnSpacing="6"
                                                              Margin="0,2">
                                                            <TextBlock Text="{Binding DisplayKey}"
                                                                       FontSize="{DynamicResource Fs10}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Text}"
                                                                     TextWrapping="Wrap"
                                                                     MinHeight="40"
                                                                     FontSize="{DynamicResource Fs12}"
                                                                     KeyDown="OnLocresTextKeyDown"
                                                                     LostFocus="OnLocresTextLostFocus" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <Border Classes="card"
                                                Padding="12"
                                                IsVisible="{Binding SelectedPatchItem.IsTexture}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="原始" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Image Source="{Binding SelectedPatchItem.OriginalPreview}"
                                                       Stretch="Uniform"
                                                       MaxHeight="200" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="card" Padding="12" IsVisible="{Binding SelectedPatchItem.IsTexture}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="替换" FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Image Source="{Binding SelectedPatchItem.ReplacementPreview}"
                                                       Stretch="Uniform"
                                                       MaxHeight="200" />
                                                <TextBlock Text="{Binding SelectedPatchItem.ReplacementText}"
                                                           FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatchItem.Error}"
                                                   FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"
                                                   IsVisible="{Binding SelectedPatchItem.IsFailed}" />

                                        <!-- 音频 / 媒体文件（竖屏单列） -->
                                        <Border Classes="card"
                                                Padding="14"
                                                IsVisible="{Binding SelectedPatchItem.IsMediaLike}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="原始" Classes="card-title" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.Detail}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="6"
                                                            IsVisible="{Binding SelectedPatchItem.IsAudio}">
                                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                    <TextBlock Text="编码质量" Classes="card-title" />
                                                    <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AudioQualities}"
                                                              SelectedItem="{Binding SelectedPatchItem.AudioQuality}"
                                                              HorizontalAlignment="Left"
                                                              MinWidth="160" />
                                                    <TextBlock Text="0 最好也最占空间，9 最省。编码后超过 256 KB 会自动切成多个流式块（和游戏自己切块的方式一致）。"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                    <TextBlock Text="替换" Classes="card-title" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.ReplacementText}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedPatchItem.ReplacementDetail}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding SelectedPatchItem.PickActionText}"
                                                    Command="{Binding PickReplacementCommand}"
                                                    Classes="accent"
                                                    IsVisible="{Binding SelectedPatchItem.CanPickFile}" />
                                            <Button Content="移除"
                                                    Command="{Binding RemovePatchItemCommand}"
                                                    Classes="ghost" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Panel>
        </Panel>
    </DockPanel>
</UserControl>
