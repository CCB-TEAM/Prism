<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.MergeView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer>
        <StackPanel MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    Margin="16,20"
                    Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="←"
                        FontSize="16"
                        Command="{Binding GoHomeCommand}" />
                <TextBlock Text="Pak 合并"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="12"
                    Padding="18">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="主 Pak" FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PakPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding PakPath}" />
                            <Button Grid.Column="1"
                                    Content="选择主 Pak"
                                    Command="{Binding BrowsePakCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="合并 Pak" FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MergePakPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding MergePakPath}" />
                            <Button Grid.Column="1"
                                    Content="选择合并 Pak"
                                    Command="{Binding BrowseMergePakCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="输出 Pak" FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MergeOutputPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding MergeOutputPath}" />
                            <Button Grid.Column="1"
                                    Content="选择输出位置"
                                    Command="{Binding BrowseMergeOutputCommand}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="AES 密钥" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AesKey}"
                                 PlaceholderText="如需解密请填写" />
                    </StackPanel>

                    <CheckBox Content="替换前询问"
                              IsChecked="{Binding AskBeforeReplace}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Content="执行合并"
                                Command="{Binding MergePakCommand}"
                                MinWidth="110" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MergeStatus}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding MergeStatus}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
