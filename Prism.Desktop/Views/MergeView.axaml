<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             x:Class="Prism.Desktop.Views.MergeView"
             x:DataType="vm:MainViewModel">

    <ScrollViewer>
        <StackPanel MaxWidth="520"
                    HorizontalAlignment="Center"
                    Margin="0,32"
                    Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="←"
                        FontSize="16"
                        Command="{Binding GoHomeCommand}" />
                <TextBlock Text="Pak 合并"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="主 Pak" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding PakPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Content="选择主 Pak"
                                    Command="{Binding BrowsePakCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="合并 Pak" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding MergePakPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Content="选择合并 Pak"
                                    Command="{Binding BrowseMergePakCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="输出 Pak" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding MergeOutputPath}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Content="选择输出位置"
                                    Command="{Binding BrowseMergeOutputCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="AES 密钥" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AesKey}"
                                 PlaceholderText="如需解密请填写"
                                 Width="280"
                                 HorizontalAlignment="Left" />
                    </StackPanel>

                    <CheckBox Content="替换前询问"
                              IsChecked="{Binding AskBeforeReplace}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="执行合并"
                                Command="{Binding MergePakCommand}"
                                MinWidth="120" />
                        <TextBlock Text="{Binding MergeStatus}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
