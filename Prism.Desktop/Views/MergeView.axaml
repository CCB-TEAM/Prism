<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             x:Class="Prism.Desktop.Views.MergeView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- 合并列表项：拖动中半透明，落点高亮 -->
        <Style Selector="Border.merge-row">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.merge-row.dragging">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.merge-row.droptarget">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <!--
        顶栏固定在顶部、不随内容滚动 —— 与「解包 & 模组」「Pak 转换」「设置」一致。
        原先这一页的顶栏在 ScrollViewer 内部，滚一下就跟着跑，是四个页面四种行为之一。
    -->
    <DockPanel>
            <!-- 顶栏与状态栏已上移到应用外壳 Views/MainView.axaml -->

        <ScrollViewer>
            <StackPanel MaxWidth="{Binding MergeContentMaxWidth}"
                        HorizontalAlignment="Stretch"
                        Margin="16,20"
                        Spacing="20">
            <!-- 宽屏两列：列表与输出并排，页面更短、一屏看全 -->
            <UniformGrid Columns="{Binding MergeColumns}">

            <!-- ═══ 输入列表 ═══ -->
            <Border Classes="card" Padding="18" Margin="{Binding CardGapMargin}">
                <StackPanel Spacing="14">
                    <DockPanel>
                        <TextBlock Text="输入 Pak" Classes="card-title" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="清空"
                                Command="{Binding ClearMergePaksCommand}"
                                Classes="ghost"
                                FontSize="{DynamicResource Fs11}" />
                    </DockPanel>

                    <TextBlock Text="越靠上优先级越高"
                               FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />

                    <!-- 空状态：一块安静的占位区，而不是一行小字 -->
                    <Border IsVisible="{Binding HasNoMergePaks}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20,24">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="还没有加入任何 Pak"
                                       FontSize="{DynamicResource Fs12}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点下面的「添加 Pak」可一次选择多个"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!--
                        拖动排序：使用指针事件（跨平台一致）。
                        - 桌面/鼠标：按住 GripArea 直接拖动
                        - Android/触摸：先长按 GripArea 激活，再拖动，避免和滚动冲突
                        逻辑在 MergeView.axaml.cs
                    -->
                    <ItemsControl ItemsSource="{Binding MergePaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MergePakItem">
                                <Border Classes="merge-row"
                                        Classes.dragging="{Binding IsDragging}"
                                        Classes.droptarget="{Binding IsDropTarget}"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                        <!-- 拖动把手 -->
                                        <Border Grid.Column="0"
                                                Name="GripArea"
                                                Background="Transparent"
                                                Padding="4,6"
                                                Cursor="SizeAll"
                                                IsVisible="{Binding CanDrag}"
                                                PointerPressed="OnMergeGripPressed"
                                                PointerMoved="OnMergeGripMoved"
                                                PointerReleased="OnMergeGripReleased"
                                                PointerCaptureLost="OnMergeGripCaptureLost"
                                                ToolTip.Tip="拖动调整覆盖顺序（手机上先长按）">
                                            <TextBlock Text="⠿" FontSize="{DynamicResource Fs15}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 优先级序号 -->
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource PrimaryWashBrush}"
                                                CornerRadius="6"
                                                MinWidth="26"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderLabel}"
                                                       FontSize="{DynamicResource Fs11}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>

                                        <!-- 文件名 + 文件数 -->
                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{DynamicResource Fs12}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Path}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- 移除 -->
                                        <Button Grid.Column="3"
                                                Content="✕"
                                                Command="{Binding $parent[UserControl].DataContext.RemoveMergePakCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="ghost"
                                                FontSize="{DynamicResource Fs12}"
                                                IsVisible="{Binding CanRemove}"
                                                ToolTip.Tip="移除这一项" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 桌面端不该有一整条青色通栏按钮（那是移动端的做法），
                         改成常规宽度的主按钮，左对齐 -->
                    <Button Content="＋ 添加 Pak（可多选）"
                            Command="{Binding BrowseMergePakCommand}"
                            Classes="primary"
                            HorizontalAlignment="Left"
                            Padding="16,9" />

                    <!-- ═══ 基准本地化（可选）═══
                         两份文本模组对每一条词条都有值，只对比它们无法判断谁改过哪条，
                         所以要有原版当参照。设了它才对同名 .locres 做逐条合并。 -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Text="基准本地化（可选）"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right"
                                    Content="清除"
                                    Command="{Binding ClearMergeBaseLocresCommand}"
                                    Classes="ghost"
                                    FontSize="{DynamicResource Fs10}"
                                    IsVisible="{Binding HasMergeBaseLocres}" />
                        </DockPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MergeBaseLocresSummary}"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding MergeBaseLocresPath}" />
                            <Button Grid.Column="1"
                                    Content="选择"
                                    Command="{Binding BrowseMergeBaseLocresCommand}"
                                    Classes="link" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 输出与执行 ═══ -->
            <Border Classes="card" Padding="18" Margin="{Binding CardGapMargin}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="输出" Classes="card-title" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MergeOutputPath}"
                                       FontSize="{DynamicResource Fs12}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding MergeOutputPath}"
                                       IsVisible="{Binding MergeOutputPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="0"
                                       Text="未选择"
                                       FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding MergeOutputPath, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                            <Button Grid.Column="1"
                                    Content="选择"
                                    Command="{Binding BrowseMergeOutputCommand}"
                                    Classes="link" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="AES 密钥" Classes="card-title" />
                        <TextBox Text="{Binding AesKey}"
                                 PlaceholderText="如需解密请填写" />
                    </StackPanel>

                    <CheckBox Content="合并前询问路径冲突"
                              IsChecked="{Binding AskBeforeReplace}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Content="执行合并"
                                Command="{Binding MergePakCommand}"
                                Classes="primary"
                                MinWidth="110" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MergeStatus}"
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding MergeStatus}" />
                    </Grid>

                    <!-- 输入摘要 -->
                    <TextBlock Text="{Binding MergeInputSummary}"
                               FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasMergePaks}" />
                </StackPanel>
            </Border>
            </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
