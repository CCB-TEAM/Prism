<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             x:Class="Prism.Desktop.Views.FileBrowserView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!--
            文件列表淡入：目录/搜索结果整批替换时，整个列表淡入，避免"啪"地换屏。
            刻意<b>不</b>做成逐项动画：locres 编辑器一次能渲染 300 行，
            逐项动画会让 300 行同时闪一下，反而更刺眼且更耗性能。
            只做 Opacity（合成层动画，不触发重排）。
        -->
        <Style Selector="ListBox.browser-list">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- 路径栏 -->
        <Border DockPanel.Dock="Top"
                Padding="10,6"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Content="上级"
                        Command="{Binding UpCommand}"
                        Classes="ghost" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentPathText}"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Background="Transparent"
                           InputElement.IsHoldingEnabled="True"
                           Holding="OnPathHolding"
                           ToolTip.Tip="长按复制路径" />
                <!-- 针对选中项的操作已移到预览栏头部（贴着她要操作的对象） -->
            </Grid>
        </Border>

        <!-- 列表 -->
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="14,8"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid ColumnDefinitions="*,90,70">
                    <TextBlock Text="名称" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="类型" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="2"
                               Text="大小"
                               FontSize="{DynamicResource Fs11}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Right" />
                </Grid>
            </Border>
            <!-- 没打开 Pak 时的空状态：列表原先只是一片空白，看不出下一步该做什么 -->
            <StackPanel Grid.Row="1"
                        Spacing="8"
                        Margin="0,80,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsPakOpen, Converter={x:Static BoolConverters.Not}}">
                <TextBlock Text="还没有打开 Pak"
                           FontSize="{DynamicResource Fs13}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="在「配置」里选择 Pak 文件，加密包另需填 AES 密钥"
                           FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="260" />
                <Button Content="去配置"
                        Command="{Binding SwitchConfigTabCommand}"
                        Classes="accent"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Classes="browser-list"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedItem}"
                     Tapped="OnListTapped"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:EntryItem">
                        <Grid ColumnDefinitions="38,*,90,70">
                            <Panel>
                                <Image Source="{Binding Thumbnail}"
                                       Width="34"
                                       Height="34"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasThumbnail}" />
                                <Border Width="28"
                                        Height="22"
                                        CornerRadius="6"
                                        Background="{DynamicResource PrimaryWashBrush}"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasThumbnail, Converter={x:Static BoolConverters.Not}}">
                                    <TextBlock Text="{Binding KindIcon}"
                                               FontSize="{DynamicResource Fs8}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{DynamicResource Fs13}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MetaText}"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Kind}"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SizeText}"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
