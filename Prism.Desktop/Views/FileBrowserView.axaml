<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             x:Class="Prism.Desktop.Views.FileBrowserView"
             x:DataType="vm:MainViewModel">

    <DockPanel>
        <!-- 路径栏 -->
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="上级"
                        Command="{Binding UpCommand}"
                        Classes="ghost" />
                <Button DockPanel.Dock="Right"
                        Content="加入替换"
                        Command="{Binding AddSelectedToPatchCommand}"
                        Classes="accent"
                        Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right"
                        Content="导出"
                        Command="{Binding ExportRawCommand}"
                        Classes="ghost" />
                <TextBlock Text="{Binding CurrentPathText}"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           FontSize="12"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 列表 -->
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="14,8"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid ColumnDefinitions="*,90,70">
                    <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="Type" FontSize="11" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="2"
                               Text="Size"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               TextAlignment="Right" />
                </Grid>
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedItem}"
                     Tapped="OnListTapped"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:EntryItem">
                        <Grid ColumnDefinitions="38,*,90,70">
                            <Panel>
                                <Image Source="{Binding Thumbnail}"
                                       Width="34"
                                       Height="34"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasThumbnail}" />
                                <Border Width="28"
                                        Height="22"
                                        CornerRadius="6"
                                        Background="{DynamicResource PrimaryWashBrush}"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasThumbnail, Converter={x:Static BoolConverters.Not}}">
                                    <TextBlock Text="{Binding KindIcon}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MetaText}"
                                           FontSize="11"
                                           Opacity="0.5"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Kind}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SizeText}"
                                       FontSize="11"
                                       Opacity="0.6"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
