<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             x:Class="Prism.Desktop.Views.PreviewPaneView"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="14" Margin="20">
        <TextBlock Text="{Binding PreviewTitle}"
                   FontSize="17"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <Border Classes="card" Padding="14">
            <Image Source="{Binding PreviewImage}"
                   Stretch="Uniform"
                   MaxHeight="420"
                   HorizontalAlignment="Center" />
        </Border>

        <TextBlock Text="{Binding PreviewEmptyText}"
                   FontSize="12"
                   Opacity="0.55"
                   IsVisible="{Binding HasPreview, Converter={x:Static BoolConverters.Not}}" />

        <!-- 音频播放条 -->
        <Border Classes="card"
                Padding="12,10"
                IsVisible="{Binding HasAudioPreview}">
            <DockPanel>
                <TextBlock Text="🔊"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right"
                        Content="{Binding AudioButtonText}"
                        Command="{Binding ToggleAudioPlaybackCommand}"
                        Classes="accent"
                        MinWidth="70" />
                <TextBlock Text="{Binding AudioStatus}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding PreviewDetails}"
                      IsVisible="{Binding HasPreview}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DetailItem">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Opacity="0.7" />
                            <TextBlock Text="{Binding Value}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPreview}">
            <Button Content="导出原始"
                    Command="{Binding ExportRawCommand}"
                    Classes="ghost" />
            <Button Content="导出预览"
                    Command="{Binding ExportPreviewCommand}"
                    Classes="ghost" />
            <Button Content="加入替换"
                    Command="{Binding AddSelectedToPatchCommand}"
                    Classes="accent" />
        </StackPanel>

        <TextBlock Text="{Binding SelectedPathText}"
                   FontSize="11"
                   Opacity="0.5"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasPreview}" />
    </StackPanel>
</UserControl>
