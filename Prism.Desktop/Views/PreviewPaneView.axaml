<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prism.Desktop.ViewModels"
             xmlns:models="using:Prism.Desktop.Models"
             xmlns:views="using:Prism.Desktop.Views"
             x:Class="Prism.Desktop.Views.PreviewPaneView"
             x:DataType="vm:MainViewModel">

    <!--
        预览栏自带头部：左是文件名，右是针对这个文件的操作（加入替换 / 更多）。
        这些操作原先挂在文件列表的路径栏上，离"选中的文件"隔着半个窗口；
        现在贴着它们要操作的对象，列表栏也就不用再挤一排按钮。
        头部常驻（没选文件时显示占位），这样「更多」里的文件夹导出仍然可达。
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="16,8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewTitle}"
                               FontSize="{DynamicResource Fs12}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding PreviewTitle}"
                               IsVisible="{Binding HasPreview}" />
                    <TextBlock Text="未选择文件"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasPreview, Converter={x:Static BoolConverters.Not}}" />
                </Panel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <!-- 蓝图节点图入口：放在头部，和「加入替换」同级，不用往下滚去找 -->
                    <Button Content="节点图"
                            Command="{Binding OpenBlueprintGraphCommand}"
                            IsVisible="{Binding HasBlueprintSummary}"
                            Classes="ghost"
                            ToolTip.Tip="从 Kismet 字节码重建的节点图（只读）" />
                    <Button Content="加入替换"
                            Command="{Binding AddSelectedToPatchCommand}"
                            Classes="accent" />
                    <Button Content="更多" Classes="ghost">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="导出原始" Command="{Binding ExportRawCommand}" />
                                <MenuItem Header="导出预览" Command="{Binding ExportPreviewCommand}" />
                                <MenuItem Header="导出本地化 JSON"
                                          Command="{Binding ExportLocresJsonCommand}"
                                          IsVisible="{Binding HasLocresPreview}" />
                                <MenuItem Header="分享原始"
                                          Command="{Binding ShareRawCommand}"
                                          IsVisible="{Binding IsAndroid}" />
                                <MenuItem Header="分享预览"
                                          Command="{Binding SharePreviewCommand}"
                                          IsVisible="{Binding IsAndroid}" />
                                <Separator />
                                <MenuItem Header="导出当前文件夹（原始）"
                                          Command="{Binding ExportFolderRawCommand}" />
                                <MenuItem Header="导出当前文件夹（PNG 图片）"
                                          Command="{Binding ExportFolderImagesCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="14" Margin="16,14">

                <Border Classes="card" Padding="14" IsVisible="{Binding HasImagePreview}">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           MaxHeight="420"
                           HorizontalAlignment="Center" />
                </Border>

                <!--
                    蓝图节点图入口：cook 后的包没有编辑器节点，图是从每个函数的 Kismet
                    字节码重建的。只读，点开是铺满整个工作区的画布。
                -->
                <Border Classes="card" Padding="14" IsVisible="{Binding HasBlueprintSummary}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="蓝图节点图"
                                       FontSize="{DynamicResource Fs12}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="从 Kismet 字节码重建事件与函数，点节点看端口和字节码位置。只读。"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding BlueprintEntryText}"
                                Classes="accent"
                                FontSize="{DynamicResource Fs11}"
                                VerticalAlignment="Center"
                                Command="{Binding OpenBlueprintGraphCommand}" />
                    </Grid>
                </Border>

                <!--
                    UMG 控件蓝图：按 Slate 布局规则渲染出的界面，点控件看属性。
                    画布 ↔ 下方详情、控件树 ↔ 属性之间的两条细条都能按住拖动改大小。
                -->
                <Border Classes="card" Padding="0" IsVisible="{Binding HasWidgetPreview}">
                    <Grid x:Name="WidgetPanelGrid" RowDefinitions="Auto,320,10,Auto">
                        <DockPanel Grid.Row="0" Margin="12,10,12,6">
                            <TextBlock Text="界面预览"
                                       FontSize="{DynamicResource Fs12}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WidgetSummary}"
                                       Margin="10,0,0,0"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <CheckBox Content="边框"
                                      IsChecked="{Binding ShowWidgetOutlines}"
                                      HorizontalAlignment="Right"
                                      FontSize="{DynamicResource Fs10}" />
                        </DockPanel>

                        <Panel Grid.Row="1" MinHeight="140">
                            <views:WidgetPreviewView Preview="{Binding WidgetPreview}"
                                                     Root="{Binding WidgetRoot}"
                                                     SelectedNode="{Binding SelectedWidgetNode, Mode=TwoWay}"
                                                     ShowOutlines="{Binding ShowWidgetOutlines}" />
                        </Panel>

                        <!-- 画布与下方详情之间的拖拽条 -->
                        <Border Grid.Row="2"
                                Classes="widget-row-handle"
                                Background="Transparent"
                                Cursor="SizeNorthSouth"
                                PointerPressed="OnWidgetCanvasHandlePressed"
                                PointerMoved="OnWidgetCanvasHandleMoved"
                                PointerReleased="OnWidgetCanvasHandleReleased">
                            <Border Height="3"
                                    Width="44"
                                    CornerRadius="2"
                                    Background="{DynamicResource DividerBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>

                        <Grid Grid.Row="3"
                              x:Name="WidgetDetailsGrid"
                              ColumnDefinitions="240,10,*"
                              Margin="12,0,12,12"
                              MaxHeight="320">
                            <Border Grid.Column="0"
                                    MinWidth="120"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    Padding="4">
                                <ListBox ItemsSource="{Binding WidgetTreeItems}"
                                         SelectedItem="{Binding SelectedWidgetItem, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WidgetTreeItem">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Margin="{Binding Indent}"
                                                       ToolTip.Tip="{Binding Tooltip}"
                                                       FontSize="{DynamicResource Fs11}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- 控件树与属性之间的拖拽条 -->
                            <Border Grid.Column="1"
                                    Classes="widget-column-handle"
                                    Background="Transparent"
                                    Cursor="SizeWestEast"
                                    PointerPressed="OnWidgetColumnHandlePressed"
                                    PointerMoved="OnWidgetColumnHandleMoved"
                                    PointerReleased="OnWidgetColumnHandleReleased">
                                <Border Height="32"
                                        Width="3"
                                        CornerRadius="2"
                                        Background="{DynamicResource DividerBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>

                            <Border Grid.Column="2"
                                    MinWidth="160"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding WidgetPropertyRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WidgetPropertyRow">
                                                <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent}">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               ToolTip.Tip="{Binding Tooltip}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding IsValue}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 文本类预览（蓝图伪代码等） -->
                <Border Classes="card" Padding="14" IsVisible="{Binding HasTextPreview}">
                    <Expander Header="伪代码 / 文本" IsExpanded="False" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding PreviewText}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="{DynamicResource Fs11}"
                                   TextWrapping="Wrap"
                                   MaxHeight="320" />
                    </Expander>
                </Border>

                <!-- 3D 模型线框预览：拖动旋转，双击复位，滚轮缩放 -->
                <Border Classes="card"
                        Padding="0"
                        Height="280"
                        ClipToBounds="True"
                        IsVisible="{Binding HasModelPreview}">
                    <Panel>
                        <views:ModelWireframeView Model="{Binding ModelPreview}" />
                        <Border Background="#33000000"
                                CornerRadius="0,0,8,8"
                                Padding="8,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                            <TextBlock Text="拖动旋转 · 滚轮缩放 · 双击复位"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="White" />
                        </Border>
                    </Panel>
                </Border>

                <!-- 空状态：一块安静居中的提示，而不是左上角一行小字 -->
                <StackPanel Spacing="8"
                            Margin="0,90,0,0"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding HasPreview, Converter={x:Static BoolConverters.Not}}">
                    <TextBlock Text="未选择文件"
                               FontSize="{DynamicResource Fs14}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="在左侧列表里点一个文件查看预览；贴图、模型、音频、视频、蓝图与界面都能读"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320" />
                </StackPanel>

                <!-- 内置音频播放器：播放/停止 + Android 进度条拖动定位 -->
                <Border Classes="card"
                        Padding="12,10"
                        IsVisible="{Binding HasAudioPreview}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="🔊"
                                       FontSize="{DynamicResource Fs16}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding AudioButtonText}"
                                    Command="{Binding ToggleAudioPlaybackCommand}"
                                    Classes="accent"
                                    MinWidth="70" />
                            <TextBlock Text="{Binding AudioStatus}"
                                       FontSize="{DynamicResource Fs12}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <Slider Grid.Column="0"
                                    Minimum="0"
                                    Maximum="{Binding AudioDuration}"
                                    Value="{Binding AudioPosition, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSeekAudio}"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnAudioSliderPressed"
                                    PointerReleased="OnAudioSliderReleased"
                                    PointerCaptureLost="OnAudioSliderCaptureLost" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AudioTimeText}"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 视频预览：ffmpeg 把帧吐进画布；没有 ffmpeg 就只给系统播放器入口 -->
                <Border Classes="card" Padding="12" IsVisible="{Binding HasVideoPreview}">
                    <StackPanel Spacing="10">
                        <Panel MinHeight="120">
                            <Image Source="{Binding VideoSurface}"
                                   Stretch="Uniform"
                                   MaxHeight="320"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="没有画面"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding HasVideoSurface, Converter={x:Static BoolConverters.Not}}" />
                        </Panel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding VideoButtonText}"
                                    Command="{Binding ToggleVideoPlaybackCommand}"
                                    Classes="accent"
                                    MinWidth="70" />
                            <Button Content="用系统播放器打开"
                                    Command="{Binding OpenVideoExternallyCommand}"
                                    Classes="ghost" />
                        </StackPanel>
                        <TextBlock Text="{Binding VideoStatus}"
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Slider Minimum="0"
                                    Maximum="{Binding VideoDuration}"
                                    Value="{Binding VideoPosition, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSeekVideo}"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnVideoSliderPressed"
                                    PointerReleased="OnVideoSliderReleased"
                                    PointerCaptureLost="OnVideoSliderCaptureLost" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VideoTimeText}"
                                       FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding PreviewDetails}"
                              IsVisible="{Binding HasPreview}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DetailItem">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="{DynamicResource Fs11}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="{DynamicResource Fs11}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPreview}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedPathText}"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Background="Transparent"
                               InputElement.IsHoldingEnabled="True"
                               Holding="OnSelectedPathHolding"
                               ToolTip.Tip="长按复制路径" />
                    <TextBlock Grid.Column="1"
                               Text="长按复制"
                               FontSize="{DynamicResource Fs10}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
