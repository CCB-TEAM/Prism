<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 设置页「信息」里显示的版本号取自本程序集 -->
    <Version>1.3.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    功能测试要直接断言"检查更新"的内部实现（发行版 JSON 解析、版本比较、自更新脚本）。
    这些类型刻意不公开成 API —— 它们只是应用内部的服务 —— 所以用 InternalsVisibleTo
    让测试看得见真实的那份实现，而不是在测试里复制一遍逻辑。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Prism.FeatureTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PakTool.Core\PakTool.Core.csproj" />
    <ProjectReference Include="..\UAssetTexture.Core\UAssetTexture.Core.csproj" />
    <ProjectReference Include="..\UAssetTexture.PakConversion\UAssetTexture.PakConversion.csproj" />
    <ProjectReference Include="..\UAssetAudio.Core\UAssetAudio.Core.csproj" />
  </ItemGroup>

  <!-- 复制编码器工具 -->
  <Target Name="CopyEncoderTools" AfterTargets="Build">
    <ItemGroup>
      <EncoderTools Include="..\tools\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(EncoderTools)"
          DestinationFiles="@(EncoderTools->'$(OutDir)tools\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
