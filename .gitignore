.env.*
*.bak
*.uasset.test
*.uexp.test
*.usmap.private

# 本地测试样本（体积大，不入库）
t_cromwell.*

# 扁平化后不再入库的目录（base 树中被 git 跟踪，扁平树里不存在）
.reasonix/
UE-Pak-Manager/

# CUE4Parse 依赖树：不随仓库提交，需自行放到 external/CUE4Parse/
# （PakTool.Core 以 ..\external\CUE4Parse\... 的项目引用方式消费它；
#   .gitmodules 无对应 gitlink，故已移除，详见 README 构建章节）
external/
