rl/
.vs/
.vscode/

bin/
obj/
rl/
.vscode/
UEBPR/App_Data/sessions/
UEBPR/App_Data/uploads/
UEBPR/App_Data/temp/
UEBPR/ClientApp/node_modules/
UEBPR/ClientApp/dist/
UEBPR/wwwroot/lib/
