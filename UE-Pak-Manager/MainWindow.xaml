<Window x:Class="UE_Pak_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UE_Pak_Manager"
        mc:Ignorable="d"
        Title="UE Pak 管理器" Height="760" Width="1180" MinHeight="650" MinWidth="1020"
        Background="#EEF2F6" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E1EA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#596579"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F5"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:DirectoryNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Padding="2"/>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="UE Pak 管理器" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="打开、提取与重新打包 Unreal Pak 文件" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,7" CornerRadius="6" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource SubTextBrush}"/>
            </Border>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="解包">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OpenPakPathTextBox" IsReadOnly="True" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="打开 Pak" Style="{StaticResource PrimaryButton}" Click="OpenPakButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PakInfoText" Text="未打开 Pak 文件" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                            <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="8,0" TextChanged="SearchTextBox_TextChanged"/>
                            <Button Grid.Column="2" Content="清空搜索" Click="ClearSearchButton_Click" Margin="0"/>
                        </Grid>

                        <DataGrid x:Name="PakFilesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pak 内路径" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="提取选中" Click="ExtractSelectedButton_Click"/>
                            <Button Content="提取全部" Style="{StaticResource PrimaryButton}" Click="ExtractAllButton_Click" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="打包">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="源目录" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="SourceDirectoryTextBox" Grid.Column="1" Margin="0,0,8,0" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="选择目录" Click="BrowseSourceButton_Click"/>
                            <TextBlock Grid.Column="4" Text="输出 Pak" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="OutputPakTextBox" Grid.Column="5" Margin="0,0,8,0"/>
                            <Button Grid.Column="6" Content="保存为" Click="BrowseOutputButton_Click" Margin="0"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="#FAFBFD">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="目录结构" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,10"/>
                                    <TreeView x:Name="PackDirectoryTree" Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="6,0,6,8" SelectedItemChanged="PackDirectoryTree_SelectedItemChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="12,10">
                                        <TextBlock x:Name="PackCurrentDirectoryText" Text="请选择源目录" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="PackFileCountText" Text="" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DataGrid x:Name="PackFilesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="220"/>
                                            <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*"/>
                                            <DataGridTextColumn Header="Pak 内路径" Binding="{Binding PakPath}" Width="*"/>
                                            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="挂载点" VerticalAlignment="Center"/>
                                <TextBox x:Name="MountPointTextBox" Grid.Column="1" Text="../../../" Margin="0,0,12,8"/>
                                <TextBlock Grid.Column="2" Text="Pak 路径前缀" VerticalAlignment="Center"/>
                                <TextBox x:Name="PakPathPrefixTextBox" Grid.Column="3" Text="Content" Margin="0,0,12,8" TextChanged="PakPathPrefixTextBox_TextChanged"/>
                                <Button Grid.Column="5" Content="开始打包" Style="{StaticResource PrimaryButton}" Click="PackButton_Click" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Text="Pak 版本" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PakVersionComboBox" Grid.Row="1" Grid.Column="1" Width="130" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="UseCompressionCheckBox" Grid.Row="1" Grid.Column="2" Content="启用压缩" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CompressionComboBox" Grid.Row="1" Grid.Column="3" Width="130" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" x:Name="PackSummaryText" Text="未选择源目录" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="BusyProgress" Grid.Row="2" Height="6" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
    </Grid>
</Window>
